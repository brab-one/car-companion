{
  "version": 1,
  "rules": [
    {"id": "cold_oil_rev", "note": "Warnings first: the first active rule decides the face.",
     "when": ["oil_c < $oil_warm_c", "rpm > 4500"], "mood": "worried", "idle": {"play": ["nervous"], "every_s": [0.3, 1]},
     "say": "Easy, the oil is still cold.", "level": 1, "cooldown_s": 120},
    {"id": "hot_coolant", "when": ["coolant_c >= 105"], "mood": "worried", "idle": {"play": ["nervous"], "every_s": [0.3, 1]},
     "say": "The coolant is getting hot.", "level": 1, "cooldown_s": 300},
    {"id": "fast", "note": "Visor down from 90 km/h, up again 8 s after slowing down. Speed comes before the Modulino.",
     "when": ["speed_kmh >= 90"], "mood": "racing", "idle": {"play": [], "every_s": [5, 12]},
     "play": "visor_down", "play_end": "visor_up", "hold_s": 8, "say": "Visor down.", "level": 3, "cooldown_s": 10},
    {"id": "shaken", "note": "Modulino Movement: shaking the board.", "when": ["motion_g >= 0.35"], "mood": "angry",
     "hold_s": 2, "say": "Hey, stop shaking me!", "level": 2, "cooldown_s": 30},
    {"id": "stopped", "note": "Standing still or crawling.", "when": ["speed_kmh < 5"], "mood": "happy",
     "idle": {"play": ["look_around"], "every_s": [0.5, 2]}},
    {"id": "cold_oil", "note": "Driving with cold oil.", "when": ["oil_c < 50"], "mood": "worried",
     "say": "Let's take it easy until the oil is warm.", "level": 2, "cooldown_s": 600},
    {"id": "hard_brake", "when": ["g_long < -0.7"], "play": "surprised", "say": "Whoa!", "level": 2, "cooldown_s": 20},
    {"id": "redline", "when": ["rpm >= $redline_rpm"], "play": "surprised", "say": "Redline!", "level": 3, "cooldown_s": 30}
  ]
}
